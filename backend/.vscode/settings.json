{
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "workbench.colorCustomizations": {
        "editor.background": "#302b2b",
        "activityBar.background": "#202020",
        "sideBar.background": "#343232",
        "editorGroupHeader.tabsBackground": "#302b2b",
        "tab.activeBackground": "#3f3f3f",
        "tab.inactiveBackground": "#302b2b",
        "titleBar.activeBackground": "#ff5a5a",
        "titleBar.activeForeground": "#ffffff",
        "statusBar.background": "#9a0000"
    },
    "editor.semanticTokenColorCustomizations": {},
    "editor.tokenColorCustomizations": {
        "comments": "#ffaeae"
    },
    "editor.mouseWheelZoom": true,
    "files.autoSave": "afterDelay",
    "workbench.iconTheme": "material-icon-theme",
    "http.systemCertificatesNode": true,
    "chat.viewSessions.orientation": "stacked",
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
        "*.csproj": "${capture}.csproj.user",
        "*.json": "${capture}.Development.json",
        "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
        "*.razor": "${capture}.razor.cs,${capture}.razor.css",
        "*.resx": "${capture}.Designer.cs",
        "*.xaml": "${capture}.xaml.cs",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "workbench.colorTheme": "Mermaid Dark"
}
